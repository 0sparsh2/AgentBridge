      "test": "plugins/agentbridge-langchain/tests/test_native_conformance.py::test_langchain_native_conformance_report_passes_offline"
    },
    {
      "name": "human_in_the_loop",
      "surfaces": ["HumanInTheLoopMiddleware", "checkpointed interrupt", "normalized workflow interrupt event"],
      "test": "plugins/agentbridge-langchain/tests/test_native_conformance.py::test_langchain_native_conformance_report_passes_offline"
    },
    {
      "name": "observability_runtime_config",
      "surfaces": ["callbacks", "tags", "run_name", "session/thread config"],
      "test": "plugins/agentbridge-langchain/tests/test_native_conformance.py::test_langchain_native_conformance_report_passes_offline"
    },
    {
      "name": "observability_provider_options",
      "surfaces": ["LangSmith config", "Langfuse config", "credential-free diagnostics"],
      "test": "plugins/agentbridge-langchain/tests/test_native_conformance.py::test_langchain_native_conformance_report_passes_offline"
    },
    {
      "name": "agentcore_bindings",
      "surfaces": ["AgentCore Memory binding", "AgentCore Gateway binding"],
      "test": "plugins/agentbridge-langchain/tests/test_native_conformance.py::test_langchain_native_conformance_report_passes_offline"
    },
    {
      "name": "async_run",
      "surfaces": ["native ainvoke", "normalized async RunResult"],
      "test": "plugins/agentbridge-langchain/tests/test_native_conformance.py::test_langchain_native_conformance_report_passes_offline"
    },
    {
      "name": "async_streaming",
      "surfaces": ["native astream/astream_events when available", "normalized async AgentEvent", "completion event"],
      "test": "plugins/agentbridge-langchain/tests/test_native_conformance.py::test_langchain_native_conformance_report_passes_offline"
    },
    {
      "name": "remote_graph_streaming",
      "surfaces": ["LangGraph thread/run API", "SSE event normalization", "RemoteGraphClient"],
      "test": "plugins/agentbridge-langchain/tests/test_remote_graph.py::test_remote_graph_normalizes_sse_lifecycle_and_result"
    },
    {
      "name": "remote_graph_lifecycle",
      "surfaces": ["thread history/copy/pruning", "checkpoint state", "run inspection/events/join/cancel/delete", "sync and async helpers"],
      "test": "plugins/agentbridge-langchain/tests/test_remote_graph.py::test_remote_graph_lifecycle_helpers_preserve_native_thread_and_run_payloads"
    },
    {
      "name": "remote_graph_discovery",
      "surfaces": ["thread search", "interrupt resolution", "assistant graph/schema/subgraph/version discovery", "run listing"],
      "test": "plugins/agentbridge-langchain/tests/test_remote_graph.py::test_remote_graph_discovery_helpers_preserve_native_filters_and_versions"
