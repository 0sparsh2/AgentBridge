    },
    {
      "name": "mcp_tool_passthrough",
      "surfaces": ["native MCP adapter tools", "create_agent tools list", "mcp_tools_count diagnostics"],
      "test": "plugins/agentbridge-langchain/tests/test_adapter.py::test_adapter_passes_native_mcp_tools_without_hard_dependency"
    },
    {
      "name": "openai_compatible_native_model",
