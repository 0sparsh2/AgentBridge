      "name": "structured_output",
      "surfaces": ["create_agent.response_format", "normalized typed output"],
      "test": "plugins/agentbridge-langchain/tests/test_native_conformance.py::test_langchain_native_conformance_report_passes_offline"
    },
    {
      "name": "tools_and_normalized_events",
      "surfaces": ["StructuredTool", "tool_call", "tool_result", "complete"],
